# Secrets — must never enter an image layer.
.env
.env.local
.env.*.local

# Local database files — these contain real PHI.
*.db
*.sqlite
*.sqlite3

# Host virtualenv (Windows) would clobber the Linux venv built inside the image.
.venv/
venv/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# VCS and editor noise
.git/
.github/
.gitignore
.vscode/
.idea/

# Docs aren't needed at runtime; excluding them keeps the build context small and avoids
# cache busts on doc-only edits. infra/ is NOT excluded (unlike an earlier version of this
# file) — infra/observability/{prometheus,grafana}/Dockerfile both COPY config files from
# inside infra/observability/, which a blanket infra/ exclusion silently broke (Docker's
# .dockerignore applies to every image built from this context, not just the root
# Dockerfile). No secrets live under infra/ — terraform.tfvars is separately gitignored and
# never committed — so including it is harmless, just a little extra (small, text-only)
# build context for the main app image.
docs/
*.md
*.pdf
