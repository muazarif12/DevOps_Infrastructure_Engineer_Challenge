# Copy to `.env` (compose) and/or `.env.local` (local `uv run` usage) and fill in real values.
# Never commit the filled-in file — both `.env` and `.env.local` are already in .gitignore.

# --- LiveKit (required by the worker) ---------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Used directly by docker-compose to build INTAKE_DB_URL for the worker/api services.
POSTGRES_DB=intake
POSTGRES_USER=intake
POSTGRES_PASSWORD=

# --- API auth ------------------------------------------------------------------
# Required on every /patients* request via the `X-API-Key` header (see app/web.py).
API_KEY=

# --- Backups (MinIO stands in for a real S3 bucket until cloud creds arrive) --
# Local review — run `docker compose --profile local-s3 up -d --build` and fill in all 6 lines
# below (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY must literally repeat the MinIO values; .env
# files can't reference other keys within themselves the way a shell script can, so this can't
# be de-duplicated).
MINIO_ROOT_USER=intake-backup
MINIO_ROOT_PASSWORD=
BACKUP_BUCKET=intake-backups
AWS_ACCESS_KEY_ID=intake-backup
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=http://minio:9000
#
# Real AWS deployment (infra/terraform/) — run plain `docker compose up -d --build` (no
# --profile local-s3) and DELETE the 3 AWS_* lines above entirely, or leave them blank. boto3
# then falls back to the EC2 instance role Terraform grants S3 access through, against the
# real bucket Terraform creates — scripts/backup.sh and restore.sh don't change at all.

# --- Grafana -------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- Domain (Caddy automatic HTTPS) ---------------------------------------------
# Set to a real hostname pointed at this host to get automatic Let's Encrypt HTTPS;
# left as localhost, Caddy just serves plain HTTP for local review.
PUBLIC_DOMAIN=localhost
