# Copy to `.env.local` for local `uv run` usage (see README's "Running without Docker").
# Never commit the filled-in file — .env.local is already in .gitignore.
#
# Railway and GCP each manage their own copies of these values separately (Railway's dashboard
# Variables tab; GCP's via Secret Manager, set in infra/terraform/terraform.tfvars) — this file
# is only for running the worker/API directly on your own machine.

# --- LiveKit (required by the worker) ---------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# Optional — omit entirely to fall back to a local SQLite file (app/store.py). Point this at a
# real Postgres (e.g. the same Railway instance the live deployment uses) to test against it
# locally instead.
# INTAKE_DB_URL=postgresql+psycopg://user:password@host:port/database
