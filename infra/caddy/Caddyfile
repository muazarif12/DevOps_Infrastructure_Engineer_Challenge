# Single-domain edge proxy: the patient-record API is the only service with a real reason
# to be internet-facing (staff tooling / EHR-side integrations).
#
# Everything else — Prometheus, Alertmanager, Grafana, MinIO, the worker's own health/metrics
# port — deliberately stays off this proxy, bound to 127.0.0.1 or the internal docker network
# only (see docker-compose.yml). In a real deployment they'd sit behind a VPN or a second,
# auth-gated Caddy site rather than the public domain at all.
#
# {$PUBLIC_DOMAIN} defaults to "localhost" (see .env.example) so this works untouched for local
# review over plain internal TLS. Point it at a real hostname whose DNS resolves to this host
# and Caddy automatically provisions a Let's Encrypt certificate — no other change required.
{$PUBLIC_DOMAIN} {
	encode gzip

	reverse_proxy api:8000

	log {
		output stdout
		format json
	}
}
