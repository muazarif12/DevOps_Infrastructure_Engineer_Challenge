# Copy to terraform.tfvars and fill in. NEVER commit the filled-in file — *.tfvars is already
# gitignored, this .example file is the only one meant to be tracked.

project_id = "your-gcp-project-id"
region     = "us-central1"

# Must match a real GitHub repo with the Cloud Build GitHub App already connected once via
# GCP Console (Cloud Build → Triggers → Connect Repository) — see infra/GCP_DEPLOYMENT.md.
github_owner = "your-github-username"
github_repo  = "PatientIntakeVoice"

backup_bucket_name = "your-globally-unique-backup-bucket-name"

# --- LiveKit ---
livekit_url        = "wss://your-project.livekit.cloud"
livekit_api_key    = "..."
livekit_api_secret = "..."

# --- Railway Postgres connection details (from Railway's Postgres service → Variables tab) ---
railway_pg_host     = "containers-us-west-1.railway.app"
railway_pg_port     = "6543"
railway_pg_database = "railway"
railway_pg_user     = "postgres"
railway_pg_password = "..."
